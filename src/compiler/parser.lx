class ParserError extends Error {
    constructor(message, pos) {
        super(`[Baris ${pos}] ${message}`);
        this.pos = pos;
    }
}

class AstNode {
    constructor(type, children, value, startPos, endPos) {
        this.jenis = type;
        this.anak = children || [];
        this.nilai = value || null;
        this.posMulai = startPos;
        this.posAkhir = endPos;
    }
}

function parse(tokens) {
    let pos = 0;
    const statements = [];
    
    function consume(expectedType, expectedValue, errorMsg) {
        if (pos >= tokens.length) {
            throw new ParserError(errorMsg || "Unexpected end of input", pos);
        }
        const token = tokens[pos];
        if (token.type !== expectedType || (expectedValue && token.value !== expectedValue)) {
            throw new ParserError(errorMsg || `Unexpected token: ${token.value}`, pos);
        }
        return tokens[pos++];
    }

    function parseBlock() {
        const start = pos;
        consume('TANDA', '{', "Ekspektasi '{' untuk memulai blok");
        const nodes = [];
        while (tokens[pos]?.value !== '}') {
            nodes.push(parseStatement());
        }
        consume('TANDA', '}', "Ekspektasi '}' untuk menutup blok");
        return new AstNode('BLOK', nodes, null, start, pos-1);
    }

    function parseStatement() {
        const token = tokens[pos];
        if (token.type === 'KUNCI') {
            switch (token.value) {
                case 'nilai': return parseDeklarasiVariabel();
                case 'fungsi': return parseDeklarasiFungsi();
                case 'jika': return parseEkspresiJika();
                case 'selama': return parseEkspresiSelama();
                case 'kembalikan': return parseReturn();
            }
        }
        return parseEkspresiStatement();
    }

    function parseDeklarasiVariabel() {
        const start = pos;
        consume('KUNCI', 'nilai', "Ekspektasi kata kunci 'nilai'");
        const identifier = consume('ID', null, "Ekspektasi identifier setelah 'nilai'");
        consume('OPERATOR', '=', "Ekspektasi operator '='");
        const expr = parseEkspresi();
        return new AstNode('DEKLARASI_VARIABEL', [expr], identifier.value, start, expr.posAkhir);
    }

    function parseDeklarasiFungsi() {
        const start = pos;
        consume('KUNCI', 'fungsi', "Ekspektasi kata kunci 'fungsi'");
        const name = consume('ID', null, "Ekspektasi nama fungsi");
        consume('TANDA', '(', "Ekspektasi '(' setelah nama fungsi");
        
        const params = [];
        while (tokens[pos]?.value !== ')') {
            params.push(consume('ID', null, "Ekspektasi parameter").value);
            if (tokens[pos]?.value === ',') consume('TANDA', ',', null);
        }
        consume('TANDA', ')', "Ekspektasi ')' setelah parameter");
        
        const body = parseBlock();
        return new AstNode('DEKLARASI_FUNGSI', [body], { 
            nama: name.value,
            parameter: params
        }, start, body.posAkhir);
    }

    function parseEkspresi() {
        return parseEkspresiLogika();
    }

    function parseEkspresiLogika() {
        let left = parseEkspresiPerbandingan();
        while (tokens[pos]?.type === 'OPERATOR' && ['&&', '||'].includes(tokens[pos].value)) {
            const operator = tokens[pos++].value;
            const right = parseEkspresiPerbandingan();
            left = new AstNode('EKSPRESI_LOGIKA', [left, right], operator, left.posMulai, right.posAkhir);
        }
        return left;
    }

    function parseEkspresiPerbandingan() {
        let left = parseEkspresiAritmatika();
        while (tokens[pos]?.type === 'OPERATOR' && ['==', '!=', '<', '>', '<=', '>='].includes(tokens[pos].value)) {
            const operator = tokens[pos++].value;
            const right = parseEkspresiAritmatika();
            left = new AstNode('EKSPRESI_PERBANDINGAN', [left, right], operator, left.posMulai, right.posAkhir);
        }
        return left;
    }

    function parseEkspresiAritmatika() {
        let node = parseTerm();
        while (tokens[pos]?.type === 'OPERATOR' && ['+', '-'].includes(tokens[pos].value)) {
            const operator = tokens[pos++].value;
            const right = parseTerm();
            node = new AstNode('EKSPRESI_ARITMATIKA', [node, right], operator, node.posMulai, right.posAkhir);
        }
        return node;
    }

    function parseTerm() {
        let node = parseFaktor();
        while (tokens[pos]?.type === 'OPERATOR' && ['*', '/', '%'].includes(tokens[pos].value)) {
            const operator = tokens[pos++].value;
            const right = parseFaktor();
            node = new AstNode('EKSPRESI_ARITMATIKA', [node, right], operator, node.posMulai, right.posAkhir);
        }
        return node;
    }

    function parseFaktor() {
        const token = tokens[pos++];
        switch (token.type) {
            case 'ANGKA':
            case 'STRING':
            case 'BOOLEAN':
                return new AstNode('LITERAL', [], token.value, token.start, token.end);
            case 'ID':
                if (tokens[pos]?.value === '(') return parsePanggilanFungsi(token);
                return new AstNode('IDENTIFIER', [], token.value, token.start, token.end);
            case 'TANDA':
                if (token.value === '(') {
                    const expr = parseEkspresi();
                    consume('TANDA', ')', "Ekspektasi ')' setelah ekspresi");
                    return expr;
                }
            default:
                throw new ParserError(`Token tidak terduga: ${token.value}`, pos-1);
        }
    }

    function parsePanggilanFungsi(identifier) {
        const start = identifier.start;
        consume('TANDA', '(', "Ekspektasi '(' setelah nama fungsi");
        const args = [];
        while (tokens[pos]?.value !== ')') {
            args.push(parseEkspresi());
            if (tokens[pos]?.value === ',') consume('TANDA', ',', null);
        }
        consume('TANDA', ')', "Ekspektasi ')' setelah argumen");
        return new AstNode('PANGGILAN_FUNGSI', args, identifier.value, start, pos-1);
    }

    try {
        while (pos < tokens.length) {
            statements.push(parseStatement());
        }
        return new AstNode('PROGRAM', statements, null, 0, pos-1);
    } catch (error) {
        if (error instanceof ParserError) {
            console.error(error.message);
            process.exit(1);
        }
        throw error;
    }
}
